{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",

    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],

    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "skipLibCheck": true,
    "noEmit": true,

    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },

  "include": ["vite.config.ts"]
}